&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    Заголовок = "Бронирование продукции";
    АвтоЗаголовок = Ложь;
    ДобавитьПоле("СостояниеБрони", "СостояниеБрони", "Состояние");
    Элементы.СостояниеБрони.ТолькоПросмотр = Истина;
    ОбновитьСостояние();
    ДобавитьКнопку("ПродатьБронь", "Продать по брони");
    ДобавитьКнопку("ОтменитьБронь", "Отменить бронь");
    ЦветФона = Новый Цвет(248, 246, 238);
    ДобавитьПоле("Дата", "Объект.Дата", "Дата");
    ДобавитьПоле("Организация", "Объект.Организация", "Организация");
    ДобавитьПоле("Склад", "Объект.Склад", "Склад");
    ДобавитьПоле("Покупатель", "Объект.Покупатель", "Покупатель");
    Если Не ЗначениеЗаполнено(Объект.СрокБрони) И Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
        Объект.СрокБрони = КонецДня(ТекущаяДатаСеанса()) + 259200;
    КонецЕсли;
    ДобавитьПоле("СрокБрони", "Объект.СрокБрони", "Действует до");
    Элементы.СрокБрони.Формат = "ДФ=dd.MM.yyyy HH:mm";
    ДобавитьКнопку("ДобавитьПродукцию", "Добавить продукцию");
    ДобавитьКнопку("УдалитьСтроку", "Удалить выбранную строку");
    Таблица = Элементы.Добавить("Товары", Тип("ТаблицаФормы"));
    Таблица.ПутьКДанным = "Объект.Товары";
    ДобавитьПоле("ТоварыНоменклатура", "Объект.Товары.Номенклатура", "Продукция", Таблица);
    ДобавитьПоле("ТоварыКоличество", "Объект.Товары.Количество", "Количество", Таблица);
    ДобавитьПоле("ТоварыЦена", "Объект.Товары.Цена", "Цена, руб.", Таблица);
    ДобавитьПоле("ТоварыСумма", "Объект.Товары.Сумма", "Сумма, руб.", Таблица);
    ДобавитьПоле("ИтогоДокумента", "ИтогоДокумента", "Итого, руб.");
    Элементы.ИтогоДокумента.ТолькоПросмотр = Истина;
    Элементы.ИтогоДокумента.Формат = "ЧДЦ=2";
    ИтогоДокумента = Объект.Товары.Итог("Сумма");
    Элементы.ТоварыСумма.ТолькоПросмотр = Истина;
    Элементы.ТоварыНоменклатура.УстановитьДействие("ПриИзменении", "ПродукцияПриИзменении");
    Элементы.ТоварыКоличество.УстановитьДействие("ПриИзменении", "СтрокаПриИзменении");
    Элементы.ТоварыЦена.УстановитьДействие("ПриИзменении", "СтрокаПриИзменении");
КонецПроцедуры

&НаКлиенте
Процедура СтрокаПриИзменении(Элемент) Экспорт
    СтрокаТовара = Элементы.Товары.ТекущиеДанные;
    Если СтрокаТовара <> Неопределено Тогда
        СтрокаТовара.Сумма = Окр(СтрокаТовара.Количество * СтрокаТовара.Цена, 2);
        ИтогоДокумента = Объект.Товары.Итог("Сумма");
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПродукцияПриИзменении(Элемент)
    СтрокаТовара = Элементы.Товары.ТекущиеДанные;
    Если СтрокаТовара <> Неопределено Тогда
        СтрокаТовара.Цена = ЦенаПродукции(Объект.Дата, СтрокаТовара.Номенклатура);
        СтрокаПриИзменении(Элемент);
    КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЦенаПродукции(ДатаДокумента, Номенклатура)
    Возврат УчетФермы.ПолучитьЦену(ДатаДокумента, Номенклатура);
КонецФункции

&НаСервере
Процедура ДобавитьПоле(Имя, Путь, Заголовок, Родитель = Неопределено)
    Поле = Элементы.Добавить(Имя, Тип("ПолеФормы"), Родитель);
    Поле.Вид = ВидПоляФормы.ПолеВвода;
    Поле.ПутьКДанным = Путь;
    Поле.Заголовок = Заголовок;
КонецПроцедуры

&НаСервере
Процедура ДобавитьКнопку(Имя, Заголовок, Родитель = Неопределено)
    Команда = Команды.Добавить(Имя);
    Команда.Заголовок = Заголовок;
    Команда.Действие = Имя;
    Кнопка = Элементы.Добавить(Имя, Тип("КнопкаФормы"), Родитель);
    Кнопка.ИмяКоманды = Имя;
    Кнопка.ЦветФона = Новый Цвет(47, 107, 79);
    Кнопка.ЦветТекста = Новый Цвет(255, 255, 255);
    Если Имя = "УдалитьСтроку" Или Имя = "СброситьОтборы"
        Или Имя = "ОткрытьПриходы" Или Имя = "ОткрытьРасходы" Тогда
        Кнопка.ЦветФона = Новый Цвет(230, 239, 231);
        Кнопка.ЦветТекста = Новый Цвет(32, 56, 44);
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьПродукцию(Команда) Экспорт
    СтрокаТовара = Объект.Товары.Добавить();
    СтрокаТовара.Количество = 1;
КонецПроцедуры

&НаКлиенте
Процедура УдалитьСтроку(Команда) Экспорт
    СтрокаТовара = Элементы.Товары.ТекущиеДанные;
    Если СтрокаТовара <> Неопределено Тогда
        Объект.Товары.Удалить(СтрокаТовара);
        ИтогоДокумента = Объект.Товары.Итог("Сумма");
    КонецЕсли;
КонецПроцедуры
&НаКлиенте
Процедура ПродатьБронь(Команда) Экспорт
    Если Модифицированность Тогда
        Сообщить("Сначала запишите и проведите бронь.");
        Возврат;
    КонецЕсли;
    СсылкаПродажи = ПродатьНаСервере();
    Если ЗначениеЗаполнено(СсылкаПродажи) Тогда
        ОткрытьФорму("Документ.Расход.ФормаОбъекта", Новый Структура("Ключ", СсылкаПродажи));
    КонецЕсли;
    ОбновитьСостояние();
КонецПроцедуры

&НаСервере
Функция ПродатьНаСервере()
    Если Не Объект.Проведен Тогда
        ВызватьИсключение "Сначала проведите бронь.";
    КонецЕсли;
    Если УчетФермы.ЕстьПродажаПоБрони(Объект.Ссылка) Тогда
        ВызватьИсключение "По этой брони уже есть проведённая продажа.";
    КонецЕсли;
    Продажа = Документы.Расход.СоздатьДокумент();
    Продажа.Дата = Макс(ТекущаяДатаСеанса(), Объект.Дата);
    Продажа.Организация = Объект.Организация;
    Продажа.Склад = Объект.Склад;
    Продажа.Покупатель = Объект.Покупатель;
    Продажа.Бронирование = Объект.Ссылка;
    Для Каждого СтрокаБрони Из Объект.Товары Цикл
        Товар = Продажа.Товары.Добавить();
        ЗаполнитьЗначенияСвойств(Товар, СтрокаБрони);
    КонецЦикла;
    Продажа.Записать(РежимЗаписиДокумента.Проведение);
    Возврат Продажа.Ссылка;
КонецФункции

&НаКлиенте
Процедура ОтменитьБронь(Команда) Экспорт
    Если Модифицированность Тогда
        Сообщить("Сначала запишите изменения или закройте форму без сохранения.");
        Возврат;
    КонецЕсли;
    ОтменитьНаСервере();
    Прочитать();
    ОбновитьСостояние();
КонецПроцедуры

&НаСервере
Процедура ОтменитьНаСервере()
    ДокументБрони = Объект.Ссылка.ПолучитьОбъект();
    ДокументБрони.Записать(РежимЗаписиДокумента.ОтменаПроведения);
КонецПроцедуры

&НаСервере
Процедура ОбновитьСостояние() Экспорт
    СостояниеБрони = УчетФермы.СостояниеБрони(Объект.Ссылка);
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
    СостояниеБрони = УчетФермы.СостояниеБрони(ТекущийОбъект.Ссылка);
КонецПроцедуры
