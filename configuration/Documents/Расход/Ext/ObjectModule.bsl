Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
    УчетФермы.ЗаблокироватьУчет();
    Если РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения Тогда
        Возврат;
    КонецЕсли;
    Если Не ЗначениеЗаполнено(Организация) Или Не ЗначениеЗаполнено(Склад)
        Или Не ЗначениеЗаполнено(Покупатель) Тогда
        Отказ = Истина;
        Сообщить("Заполните организацию, склад и контрагента.");
    КонецЕсли;
    Если Товары.Количество() = 0 Тогда
        Отказ = Истина;
        Сообщить("Добавьте продукцию в документ.");
    КонецЕсли;
    Для Каждого СтрокаТовара Из Товары Цикл
        Если Не ЗначениеЗаполнено(СтрокаТовара.Номенклатура)
            Или СтрокаТовара.Количество <= 0 Или СтрокаТовара.Цена <= 0 Тогда
            Отказ = Истина;
            Сообщить("В каждой строке укажите продукцию, положительное количество и цену.");
        КонецЕсли;
        СтрокаТовара.Сумма = Окр(СтрокаТовара.Количество * СтрокаТовара.Цена, 2);
    КонецЦикла;
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
    УчетФермы.ПроверитьПродажуПоБрони(ЭтотОбъект);
    Движения.ОстаткиПродукции.Записывать = Истина;
    Движения.ОстаткиПродукции.Очистить();
    Движения.ОстаткиПродукции.БлокироватьДляИзменения = Истина;
    Для Каждого СтрокаТовара Из Товары Цикл
        Движение = Движения.ОстаткиПродукции.Добавить();
        Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
        Движение.Период = Дата;
        Движение.Организация = Организация;
        Движение.Склад = Склад;
        Движение.Номенклатура = СтрокаТовара.Номенклатура;
        Движение.Количество = СтрокаТовара.Количество;
    КонецЦикла;
    Движения.ОстаткиПродукции.Записать();
    Движения.РезервыПродукции.Записывать = Истина;
    Движения.РезервыПродукции.Очистить();
    Если ЗначениеЗаполнено(Бронирование) Тогда
        Для Каждого Товар Из Товары Цикл
            Резерв = Движения.РезервыПродукции.Добавить();
            Резерв.ВидДвижения = ВидДвиженияНакопления.Расход;
            Резерв.Период = Дата;
            Резерв.Организация = Организация;
            Резерв.Склад = Склад;
            Резерв.Номенклатура = Товар.Номенклатура;
            Резерв.Бронирование = Бронирование;
            Резерв.Количество = Товар.Количество;
        КонецЦикла;
    КонецЕсли;
    Движения.РезервыПродукции.Записать();

    УчетФермы.ПроверитьОстатки(Организация, Склад, Отказ);
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
    УчетФермы.ЗаблокироватьУчет();
    Движения.ОстаткиПродукции.Записывать = Истина;
    Движения.ОстаткиПродукции.Очистить();
    Движения.ОстаткиПродукции.БлокироватьДляИзменения = Истина;
    Движения.ОстаткиПродукции.Записать();
    Движения.РезервыПродукции.Записывать = Истина;
    Движения.РезервыПродукции.Очистить();
    Движения.РезервыПродукции.Записать();
    УчетФермы.ПроверитьОстатки(Организация, Склад, Отказ);
КонецПроцедуры

Процедура ПередУдалением(Отказ)
    Если Проведен Тогда
        ВызватьИсключение "Сначала отмените проведение документа.";
    КонецЕсли;
КонецПроцедуры
