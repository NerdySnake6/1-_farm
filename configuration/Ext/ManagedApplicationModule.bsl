Процедура ПриНачалеРаботыСистемы()
    Если Лев(ПараметрЗапуска, 21) = "FarmReservationTests=" Тогда
        СервисФермы.ПроверитьБронирование(Сред(ПараметрЗапуска, 22));
        ПротоколБрони = Новый ЗаписьТекста(Сред(ПараметрЗапуска, 22) + "/.build/reservation-form-tests.txt", КодировкаТекста.UTF8);
        СсылкаБрони = Неопределено;
        Попытка
            СсылкаБрони = СервисФермы.ПодготовитьПроверкуФормыБрони(Сред(ПараметрЗапуска, 22));
            ФормаБрони = ПолучитьФорму("Документ.Бронирование.Форма.Форма", Новый Структура("Ключ", СсылкаБрони));
            ФормаБрони.Открыть();
            Если ФормаБрони.Команды.Найти("ПродатьБронь") = Неопределено Или ФормаБрони.СостояниеБрони <> "Забронирована" Тогда
                ВызватьИсключение "Не созданы команды или состояние брони";
            КонецЕсли;
            ПротоколБрони.ЗаписатьСтроку("PASS | BF01 Форма брони и состояние созданы");
            ФормаБрони.ПродатьБронь(Неопределено);
            Если СервисФермы.СостояниеБрониДляТеста(СсылкаБрони) <> "Продана" Тогда ВызватьИсключение "Кнопка не продала бронь"; КонецЕсли;
            ПротоколБрони.ЗаписатьСтроку("PASS | BF02 Обработчик Продать по брони создает проведенную продажу");
            ОтказПовтора = Ложь;
            Попытка ФормаБрони.ПродатьБронь(Неопределено); Исключение ОтказПовтора = Истина; КонецПопытки;
            Если Не ОтказПовтора Тогда ВызватьИсключение "Повторная продажа по кнопке не отклонена"; КонецЕсли;
            ПротоколБрони.ЗаписатьСтроку("PASS | BF03 Повторная команда продажи отклонена");
            СервисФермы.ОтменитьПродажуТестаБрони(СсылкаБрони);
            ФормаБрони.ОтменитьБронь(Неопределено);
            Если СервисФермы.СостояниеБрониДляТеста(СсылкаБрони) = "Забронирована" Тогда ВызватьИсключение "Команда не отменила бронь"; КонецЕсли;
            ПротоколБрони.ЗаписатьСтроку("PASS | BF04 Обработчик Отменить бронь снимает резерв");
            ОтчетБрони = ПолучитьФорму("Отчет.ОстаткиПродукции.Форма.Форма");
            ОтчетБрони.СформироватьОтчет(Неопределено);
            Если ОтчетБрони.РезультатОтчета.Область(4, 5).Текст <> "НаСкладе"
                Или ОтчетБрони.РезультатОтчета.Область(4, 6).Текст <> "ВРезерве"
                Или ОтчетБрони.РезультатОтчета.Область(4, 7).Текст <> "Свободно" Тогда
                ВызватьИсключение "Отчет не показывает свободный остаток";
            КонецЕсли;
            ПротоколБрони.ЗаписатьСтроку("PASS | BF05 Отчет содержит склад, резерв и свободный остаток");
            ПанельБрони = ПолучитьФорму("ОбщаяФорма.ПанельПродажа");
            Если ПанельБрони.Команды.Найти("СоздатьБронь") = Неопределено Или ПанельБрони.Команды.Найти("ОткрытьБрони") = Неопределено Тогда
                ВызватьИсключение "Нет команд брони в разделе Продажа";
            КонецЕсли;
            ПротоколБрони.ЗаписатьСтроку("PASS | BF06 На странице Продажа есть создание и журнал броней");
            ПротоколБрони.ЗаписатьСтроку("COMPLETE");
        Исключение
            ПротоколБрони.ЗаписатьСтроку("ERROR | " + ОписаниеОшибки());
        КонецПопытки;
        Если ЗначениеЗаполнено(СсылкаБрони) Тогда
            Попытка СервисФермы.ЗавершитьПроверкуФормыБрони(СсылкаБрони);
            Исключение ПротоколБрони.ЗаписатьСтроку("ERROR | Очистка: " + ОписаниеОшибки()); КонецПопытки;
        КонецЕсли;
        ПротоколБрони.Закрыть();

        ЗавершитьРаботуСистемы(Ложь);
        Возврат;
    КонецЕсли;
    Если Лев(ПараметрЗапуска, 9) = "FarmRole=" Тогда
        КаталогПроекта = Сред(ПараметрЗапуска, 10);
        Протокол = Новый ЗаписьТекста(КаталогПроекта + "/.build/role-" + ИмяПользователя() + ".txt", КодировкаТекста.UTF8);
        Попытка
            Протокол.ЗаписатьСтроку(СервисФермы.ПроверитьРабочуюРоль());
            РабочийСтол = ПолучитьФорму("ОбщаяФорма.РабочийСтол");
            Если ИмяПользователя() = "Покупка" Тогда
                Если РабочийСтол.Команды.Найти("СоздатьРасход") <> Неопределено Тогда
                    ВызватьИсключение "Покупке показана кнопка продажи";
                КонецЕсли;
            ИначеЕсли ИмяПользователя() = "Продажа" Тогда
                Если РабочийСтол.Команды.Найти("СоздатьПриход") <> Неопределено Тогда
                    ВызватьИсключение "Продаже показана кнопка прихода";
                КонецЕсли;
            КонецЕсли;
            Протокол.ЗаписатьСтроку("PASS | R06 Рабочий стол показывает кнопки по роли");
            Панель = ПолучитьФорму("ОбщаяФорма.Панель" + ИмяПользователя());
            Панель.Открыть();
            Панель.ОткрытьОрганизации(Неопределено);
            Панель.ОткрытьСклады(Неопределено);
            Если ИмяПользователя() = "Покупка" Тогда
                Панель.ОткрытьПоставщиков(Неопределено);
            Иначе
                Панель.ОткрытьПокупателей(Неопределено);
            КонецЕсли;
            Протокол.ЗаписатьСтроку("PASS | R07 Панель раздела и справочники доступны рабочей роли");
        Исключение
            Протокол.ЗаписатьСтроку("ERROR | " + ОписаниеОшибки());
        КонецПопытки;
        Протокол.Закрыть();
        ЗавершитьРаботуСистемы(Ложь);
        Возврат;
    КонецЕсли;
    Если ПараметрЗапуска = "FarmUsers" Тогда
        СервисФермы.СоздатьУчебныхПользователей();
        ЗавершитьРаботуСистемы(Ложь);
        Возврат;
    КонецЕсли;
    Если Лев(ПараметрЗапуска, 10) = "FarmTests=" Тогда
        КаталогПроекта = Сред(ПараметрЗапуска, 11);
        СервисФермы.ВыполнитьПроверки(КаталогПроекта);
        ПротоколФорм = Новый ЗаписьТекста(КаталогПроекта + "/.build/form-tests.txt", КодировкаТекста.UTF8);
        Попытка
            Форма = ПолучитьФорму("ОбщаяФорма.РабочийСтол");
            ПротоколФорм.ЗаписатьСтроку("PASS | F06 Рабочий стол и кнопки операций созданы");
            Ссылка = СервисФермы.ПолучитьМолоко();
            Форма = ПолучитьФорму("Справочник.Номенклатура.Форма.Форма", Новый Структура("Ключ", Ссылка));
            ПротоколФорм.ЗаписатьСтроку("PASS | F01 Карточка номенклатуры и поле фотографии созданы");
            Форма = ПолучитьФорму("Документ.Приход.Форма.Форма");
            Форма.Открыть();
            Форма.ДобавитьПродукцию(Неопределено);
            Если Форма.Объект.Товары.Количество() <> 1 Тогда
                ВызватьИсключение "Кнопка добавления продукции не создала строку";
            КонецЕсли;
            ПротоколФорм.ЗаписатьСтроку("PASS | F02 Форма прихода и кнопка добавления продукции работают");
            СтрокаТовара = Форма.Объект.Товары[0];
            СтрокаТовара.Количество = 2;
            СтрокаТовара.Цена = 90;
            Форма.Элементы.Товары.ТекущаяСтрока = СтрокаТовара.ПолучитьИдентификатор();
            Форма.СтрокаПриИзменении(Неопределено);
            Если Форма.ИтогоДокумента <> 180 Тогда
                ВызватьИсключение "Итог документа не пересчитан";
            КонецЕсли;
            Форма.УдалитьСтроку(Неопределено);
            Если Форма.Объект.Товары.Количество() <> 0 Или Форма.ИтогоДокумента <> 0 Тогда
                ВызватьИсключение "Строка не удалена или итог не обнулен";
            КонецЕсли;
            ПротоколФорм.ЗаписатьСтроку("PASS | F07 Пересчет итога и удаление строки работают");
            Форма = ПолучитьФорму("Документ.Расход.Форма.Форма");
            ПротоколФорм.ЗаписатьСтроку("PASS | F03 Форма расхода создана");
            Форма = ПолучитьФорму("Отчет.ОстаткиПродукции.Форма.Форма");
            Форма.СформироватьОтчет(Неопределено);
            Форма.ОтборСклад = СервисФермы.ПолучитьПустойСклад();
            Форма.СформироватьОтчет(Неопределено);
            Если Форма.РезультатОтчета.Область(5, 1).Текст <> "По выбранным условиям данных нет" Тогда
                ВызватьИсключение "Фильтр склада не ограничил остатки";
            КонецЕсли;
            Форма.СброситьОтборы(Неопределено);
            ПротоколФорм.ЗаписатьСтроку("PASS | F04 Остатки, фильтр склада и сброс фильтра работают");
            Форма = ПолучитьФорму("Отчет.ПродажиЗаПериод.Форма.Форма");
            Форма.СформироватьОтчет(Неопределено);
            ПротоколФорм.ЗаписатьСтроку("PASS | F05 Отчет о продажах сформирован");
            РабочийСтол = ПолучитьФорму("ОбщаяФорма.РабочийСтол");
            РабочийСтол.СоздатьПриход(Неопределено);
            РабочийСтол.ОткрытьПриходы(Неопределено);
            РабочийСтол.СоздатьРасход(Неопределено);
            РабочийСтол.ОткрытьРасходы(Неопределено);
            РабочийСтол.ОткрытьПродукцию(Неопределено);
            РабочийСтол.ОткрытьЦены(Неопределено);
            РабочийСтол.ОткрытьОстатки(Неопределено);
            РабочийСтол.ОткрытьПродажи(Неопределено);
            ПротоколФорм.ЗаписатьСтроку("PASS | F08 Все восемь переходов рабочего стола выполнены");
            Для Повтор = 1 По 2 Цикл
                Панель = ПолучитьФорму("ОбщаяФорма.ПанельПокупка");
                Панель.Открыть();
                Если Панель.Заголовок <> "Покупка продукции"
                    Или Панель.Команды.Найти("СоздатьПриход") = Неопределено
                    Или Панель.Команды.Найти("СоздатьРасход") <> Неопределено Тогда
                    ВызватьИсключение "Неверные команды панели Покупка";
                КонецЕсли;
                Панель.ОткрытьПоставщиков(Неопределено);
                Панель.ОткрытьОрганизации(Неопределено);
                Панель.ОткрытьСклады(Неопределено);
                Панель.Закрыть();
            КонецЦикла;
            ПротоколФорм.ЗаписатьСтроку("PASS | F09 Покупка: повторное открытие панели и справочников");
            Для Повтор = 1 По 2 Цикл
                Панель = ПолучитьФорму("ОбщаяФорма.ПанельПродажа");
                Панель.Открыть();
                Если Панель.Заголовок <> "Продажа продукции"
                    Или Панель.Команды.Найти("СоздатьРасход") = Неопределено
                    Или Панель.Команды.Найти("СоздатьПриход") <> Неопределено Тогда
                    ВызватьИсключение "Неверные команды панели Продажа";
                КонецЕсли;
                Панель.ОткрытьПокупателей(Неопределено);
                Панель.ОткрытьОрганизации(Неопределено);
                Панель.ОткрытьСклады(Неопределено);
                Панель.Закрыть();
            КонецЦикла;
            ПротоколФорм.ЗаписатьСтроку("PASS | F10 Продажа: повторное открытие панели и справочников");
        Исключение
            ПротоколФорм.ЗаписатьСтроку("ERROR | " + ОписаниеОшибки());
        КонецПопытки;
        ПротоколФорм.Закрыть();
        ЗавершитьРаботуСистемы(Ложь);
        Возврат;
    КонецЕсли;
    ОткрытьФорму("ОбщаяФорма.РабочийСтол");
КонецПроцедуры
