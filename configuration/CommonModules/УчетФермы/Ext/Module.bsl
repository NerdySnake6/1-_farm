Процедура ЗаблокироватьУчет() Экспорт
    // Общий порядок блокировок для проведения и отмены всех складских операций.
    Блокировка = Новый БлокировкаДанных;
    Блокировка.Добавить("РегистрНакопления.ОстаткиПродукции");
    Блокировка.Добавить("РегистрНакопления.РезервыПродукции");
    Блокировка.Заблокировать();
КонецПроцедуры

Функция ЕстьПродажаПоБрони(Бронь, ИсключитьПродажу = Неопределено) Экспорт
    Если Не ЗначениеЗаполнено(Бронь) Тогда Возврат Ложь; КонецЕсли;
    Если ИсключитьПродажу = Неопределено Тогда
        ИсключитьПродажу = Документы.Расход.ПустаяСсылка();
    КонецЕсли;
    Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Документ.Расход
    |ГДЕ Проведен И Бронирование = &Бронь И Ссылка <> &Исключить");
    Запрос.УстановитьПараметр("Бронь", Бронь);
    Запрос.УстановитьПараметр("Исключить", ИсключитьПродажу);
    Возврат Не Запрос.Выполнить().Пустой();
КонецФункции

Функция СостояниеБрони(Бронь) Экспорт
    Если Не ЗначениеЗаполнено(Бронь) Тогда
        Возврат "Не записана";
    КонецЕсли;
    Если ЕстьПродажаПоБрони(Бронь) Тогда
        Возврат "Продана";
    КонецЕсли;
    Если Бронь.Проведен Тогда
        Возврат "Забронирована";
    КонецЕсли;
    Возврат "Не действует (не проведена или отменена)";
КонецФункции

Процедура ПроверитьПродажуПоБрони(Продажа) Экспорт
    Бронь = Продажа.Бронирование;
    Если Не ЗначениеЗаполнено(Бронь) Тогда
        Возврат;
    КонецЕсли;
    Если Не Бронь.Проведен Или Бронь.ПометкаУдаления Тогда
        ВызватьИсключение "Бронь не действует. Выберите проведённую бронь.";
    КонецЕсли;
    Если ЕстьПродажаПоБрони(Бронь, Продажа.Ссылка) Тогда
        ВызватьИсключение "По этой брони уже проведена продажа.";
    КонецЕсли;
    Если Продажа.Организация <> Бронь.Организация Или Продажа.Склад <> Бронь.Склад
        Или Продажа.Покупатель <> Бронь.Покупатель Тогда
        ВызватьИсключение "Организация, склад и покупатель должны совпадать с бронью.";
    КонецЕсли;
    Если Продажа.Дата < Бронь.Дата Тогда
        ВызватьИсключение "Продажа не может быть раньше брони.";
    КонецЕсли;
    ТоварыБрони = Бронь.Товары.Выгрузить();
    ТоварыПродажи = Продажа.Товары.Выгрузить();
    ТоварыБрони.Свернуть("Номенклатура", "Количество");
    ТоварыПродажи.Свернуть("Номенклатура", "Количество");
    Если ТоварыБрони.Количество() <> ТоварыПродажи.Количество() Тогда
        ВызватьИсключение "Продажа по брони должна включать всю забронированную продукцию.";
    КонецЕсли;
    Для Каждого СтрокаБрони Из ТоварыБрони Цикл
        СтрокаПродажи = ТоварыПродажи.Найти(СтрокаБрони.Номенклатура, "Номенклатура");
        Если СтрокаПродажи = Неопределено Тогда
            ВызватьИсключение "Состав продукции не совпадает с бронью.";
        КонецЕсли;
        Если СтрокаПродажи.Количество <> СтрокаБрони.Количество Тогда
            ВызватьИсключение "Количество не совпадает с бронью. Частичная продажа не предусмотрена.";
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Процедура ПроверитьОстатки(Организация, Склад, Отказ) Экспорт
    Запрос = Новый Запрос("ВЫБРАТЬ Номенклатура ИЗ РегистрНакопления.РезервыПродукции.Остатки()
    |ГДЕ КоличествоОстаток < 0");
    Если Не Запрос.Выполнить().Пустой() Тогда
        Отказ = Истина;
        Сообщить("Резерв уже использован или изменён. Проверьте бронь и продажу.");
        Возврат;
    КонецЕсли;
    Запрос.Текст = "ВЫБРАТЬ Д.Номенклатура,
    |СУММА(Д.НаСкладе) КАК НаСкладе, СУММА(Д.Резерв) КАК Резерв
    |ИЗ (ВЫБРАТЬ Организация, Склад, Номенклатура,
    |КоличествоОстаток КАК НаСкладе, 0 КАК Резерв
    |ИЗ РегистрНакопления.ОстаткиПродукции.Остатки()
    |ОБЪЕДИНИТЬ ВСЕ ВЫБРАТЬ Организация, Склад, Номенклатура,
    |0, КоличествоОстаток ИЗ РегистрНакопления.РезервыПродукции.Остатки()) КАК Д
    |СГРУППИРОВАТЬ ПО Д.Организация, Д.Склад, Д.Номенклатура
    |ИМЕЮЩИЕ СУММА(Д.НаСкладе) < 0 ИЛИ СУММА(Д.НаСкладе) - СУММА(Д.Резерв) < 0";
    Выборка = Запрос.Выполнить().Выбрать();
    Пока Выборка.Следующий() Цикл
        Отказ = Истина;
        Сообщить("Недостаточно свободной продукции: " + Строка(Выборка.Номенклатура)
            + ". На складе: " + Строка(Выборка.НаСкладе) + ", резерв: " + Строка(Выборка.Резерв));
    КонецЦикла;
КонецПроцедуры

Функция ПолучитьЦену(ДатаДокумента, Номенклатура) Экспорт
    Запрос = Новый Запрос;
    Запрос.Текст = "ВЫБРАТЬ Цена ИЗ РегистрСведений.Цены.СрезПоследних(&Дата,
    |Номенклатура = &Номенклатура)";
    Запрос.УстановитьПараметр("Дата", КонецДня(ДатаДокумента));
    Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
    Выборка = Запрос.Выполнить().Выбрать();
    Если Выборка.Следующий() Тогда
        Возврат Выборка.Цена;
    КонецЕсли;
    Возврат 0;
КонецФункции
