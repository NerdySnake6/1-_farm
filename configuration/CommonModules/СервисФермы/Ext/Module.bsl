// Служебные операции разрешены только администратору учебной базы.
Процедура ПроверитьАдминистратора()
    Если Не РольДоступна("ПолныеПрава") Тогда
        ВызватьИсключение "Операция доступна только пользователю с полными правами.";
    КонецЕсли;
КонецПроцедуры

Функция СоздатьЭлемент(Менеджер, Наименование)
    Ссылка = Менеджер.НайтиПоНаименованию(Наименование, Истина);
    Если ЗначениеЗаполнено(Ссылка) Тогда
        Возврат Ссылка;
    КонецЕсли;
    Элемент = Менеджер.СоздатьЭлемент();
    Элемент.Наименование = Наименование;
    Элемент.Записать();
    Возврат Элемент.Ссылка;
КонецФункции

Функция ЗаполнитьПример(КаталогПроекта) Экспорт
    ПроверитьАдминистратора();
    Организация = СоздатьЭлемент(Справочники.Организации, "Молочная ферма Луговая");
    Склад = СоздатьЭлемент(Справочники.Склады, "Холодильный склад");
    Поставщик = СоздатьЭлемент(Справочники.Поставщики, "Кооператив Молочный край");
    Покупатель = СоздатьЭлемент(Справочники.Покупатели, "Магазин Свежие продукты");
    Имена = СтрРазделить("Молоко 3,2%;Творог 9%;Сметана 20%", ";");
    Файлы = СтрРазделить("milk.png;curd.png;cream.png", ";");
    Единицы = СтрРазделить("л;кг;кг", ";");
    Цены = Новый Массив;
    Цены.Добавить(90); Цены.Добавить(360); Цены.Добавить(280);
    Продукция = Новый Массив;
    Для Индекс = 0 По 2 Цикл
        Ссылка = СоздатьЭлемент(Справочники.Номенклатура, Имена[Индекс]);
        Элемент = Ссылка.ПолучитьОбъект();
        Элемент.ЕдиницаИзмерения = Единицы[Индекс];
        ФайлФото = Новый Файл(КаталогПроекта + "/assets/" + Файлы[Индекс]);
        Если ФайлФото.Существует() Тогда
            Элемент.Фотография = Новый ХранилищеЗначения(Новый ДвоичныеДанные(ФайлФото.ПолноеИмя));
        КонецЕсли;
        Элемент.Записать();
        Продукция.Добавить(Ссылка);
        ЗаписьЦены = РегистрыСведений.Цены.СоздатьМенеджерЗаписи();
        ЗаписьЦены.Период = НачалоДня(ТекущаяДатаСеанса());
        ЗаписьЦены.Номенклатура = Ссылка;
        ЗаписьЦены.Цена = Цены[Индекс];
        ЗаписьЦены.Записать();
    КонецЦикла;
    Данные = Новый Структура("Организация,Склад,Поставщик,Покупатель,Продукция,Цены", Организация, Склад, Поставщик, Покупатель, Продукция, Цены);
    Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Документ.Приход");
    Если Запрос.Выполнить().Пустой() Тогда
        Приход = НовыйДокумент("Приход", Данные, 100, 20, 15);
        Приход.Записать(РежимЗаписиДокумента.Проведение);
        Расход = НовыйДокумент("Расход", Данные, 25, 5, 3);
        Расход.Записать(РежимЗаписиДокумента.Проведение);
    КонецЕсли;
    Возврат Данные;
КонецФункции

Функция НовыйДокумент(Вид, Данные, Молоко, Творог, Сметана)
    Документ = Документы[Вид].СоздатьДокумент();
    Документ.Дата = ТекущаяДатаСеанса();
    Документ.Организация = Данные.Организация;
    Документ.Склад = Данные.Склад;
    Если Вид = "Приход" Тогда
        Документ.Поставщик = Данные.Поставщик;
    Иначе
        Документ.Покупатель = Данные.Покупатель;
    КонецЕсли;
    Количества = Новый Массив;
    Количества.Добавить(Молоко); Количества.Добавить(Творог); Количества.Добавить(Сметана);
    Для Индекс = 0 По 2 Цикл
        СтрокаТовара = Документ.Товары.Добавить();
        СтрокаТовара.Номенклатура = Данные.Продукция[Индекс];
        СтрокаТовара.Количество = Количества[Индекс];
        СтрокаТовара.Цена = Данные.Цены[Индекс];
    КонецЦикла;
    Возврат Документ;
КонецФункции

Функция Остаток(Данные, Индекс)
    Запрос = Новый Запрос("ВЫБРАТЬ КоличествоОстаток ИЗ РегистрНакопления.ОстаткиПродукции.Остатки(, Организация = &Организация И Склад = &Склад И Номенклатура = &Продукция)");
    Запрос.УстановитьПараметр("Организация", Данные.Организация);
    Запрос.УстановитьПараметр("Склад", Данные.Склад);
    Запрос.УстановитьПараметр("Продукция", Данные.Продукция[Индекс]);
    Выборка = Запрос.Выполнить().Выбрать();
    Если Выборка.Следующий() Тогда
        Возврат Выборка.КоличествоОстаток;
    КонецЕсли;
    Возврат 0;
КонецФункции

Процедура Утвердить(Условие, ИмяТеста, Протокол)
    Если Не Условие Тогда
        Протокол.Добавить("FAIL | " + ИмяТеста);
        ВызватьИсключение ИмяТеста;
    КонецЕсли;
    Протокол.Добавить("PASS | " + ИмяТеста);
КонецПроцедуры

Процедура ОжидаетсяОтказ(Документ, ИмяТеста, Протокол, Режим = Неопределено)
    БылОтказ = Ложь;
    НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
    Попытка
        Если Режим = Неопределено Тогда
            Документ.Записать(РежимЗаписиДокумента.Проведение);
        Иначе
            Документ.Записать(Режим);
        КонецЕсли;
    Исключение
        БылОтказ = Истина;
    КонецПопытки;
    ОтменитьТранзакцию();
    Утвердить(БылОтказ, ИмяТеста, Протокол);
КонецПроцедуры

Процедура ВыполнитьПроверки(КаталогПроекта) Экспорт
    ПроверитьАдминистратора();
    Протокол = Новый Массив;
    Попытка
        Данные = ЗаполнитьПример(КаталогПроекта);
        Утвердить(Остаток(Данные, 0) = 75, "T01 Молоко 100 - 25 = 75 л", Протокол);
        Утвердить(Остаток(Данные, 1) = 15, "T02 Творог 20 - 5 = 15 кг", Протокол);
        Утвердить(Остаток(Данные, 2) = 12, "T03 Сметана 15 - 3 = 12 кг", Протокол);
        Утвердить(УчетФермы.ПолучитьЦену(ТекущаяДатаСеанса(), Данные.Продукция[0]) = 90, "T04 Цена молока из регистра", Протокол);
        Для Каждого Продукт Из Данные.Продукция Цикл
            Утвердить(Продукт.Фотография.Получить() <> Неопределено, "T05 Фото " + Строка(Продукт), Протокол);
        КонецЦикла;
        Документ = НовыйДокумент("Расход", Данные, 76, 1, 1);
        ОжидаетсяОтказ(Документ, "T06 Продажа сверх остатка", Протокол);
        Утвердить(Остаток(Данные, 0) = 75, "T07 Остаток сохранен после отказа", Протокол);
        Документ = НовыйДокумент("Расход", Данные, 0, 1, 1);
        ОжидаетсяОтказ(Документ, "T08 Нулевое количество", Протокол);
        Документ = НовыйДокумент("Приход", Данные, -1, 1, 1);
        ОжидаетсяОтказ(Документ, "T09 Отрицательное количество", Протокол);
        Документ = НовыйДокумент("Расход", Данные, 1, 1, 1);
        Документ.Товары[0].Цена = 0;
        ОжидаетсяОтказ(Документ, "T10 Нулевая цена", Протокол);
        Документ = НовыйДокумент("Приход", Данные, 1, 1, 1);
        Документ.Склад = Справочники.Склады.ПустаяСсылка();
        ОжидаетсяОтказ(Документ, "T11 Не заполнен склад", Протокол);
        Документ = НовыйДокумент("Приход", Данные, 1, 1, 1);
        Документ.Товары.Очистить();
        ОжидаетсяОтказ(Документ, "T12 Пустая табличная часть", Протокол);
        НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
        Документ = НовыйДокумент("Расход", Данные, 1, 1, 1);
        Документ.Записать(РежимЗаписиДокумента.Проведение);
        Утвердить(Остаток(Данные, 0) = 74, "T13 Движение продажи", Протокол);
        Утвердить(Документ.Товары[0].Сумма = 90, "T14 Расчет суммы", Протокол);
        Документ.Записать(РежимЗаписиДокумента.Проведение);
        Утвердить(Остаток(Данные, 0) = 74, "T15 Перепроведение без дублей", Протокол);
        Документ.Записать(РежимЗаписиДокумента.ОтменаПроведения);
        Утвердить(Остаток(Данные, 0) = 75, "T16 Отмена продажи возвращает остаток", Протокол);
        ОтменитьТранзакцию();
        Выборка = Документы.Приход.Выбрать();
        Выборка.Следующий();
        ОжидаетсяОтказ(Выборка.ПолучитьОбъект(), "T17 Запрет отмены прихода при проданной продукции", Протокол, РежимЗаписиДокумента.ОтменаПроведения);
        НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
        Документ = НовыйДокумент("Расход", Данные, 1, 1, 1);
        СтрокаТовара = Документ.Товары.Добавить();
        СтрокаТовара.Номенклатура = Данные.Продукция[0];
        СтрокаТовара.Количество = 75;
        СтрокаТовара.Цена = 90;
        ОтменитьТранзакцию();
        ОжидаетсяОтказ(Документ, "T18 Повторяющиеся строки учитываются суммарно", Протокол);
        Запрос = Новый Запрос("ВЫБРАТЬ СУММА(Т.Сумма) КАК Сумма ИЗ Документ.Расход.Товары КАК Т ГДЕ Т.Ссылка.Проведен");
        Выборка = Запрос.Выполнить().Выбрать(); Выборка.Следующий();
        Утвердить(Выборка.Сумма = 4890, "T19 Сумма продаж 4890 руб", Протокол);
        Протокол.Добавить("COMPLETE");
    Исключение
        Если ТранзакцияАктивна() Тогда
            ОтменитьТранзакцию();
        КонецЕсли;
        Протокол.Добавить("ERROR | " + ОписаниеОшибки());
    КонецПопытки;
    ФайлПротокола = Новый ЗаписьТекста(КаталогПроекта + "/.build/runtime-tests.txt", КодировкаТекста.UTF8);
    Для Каждого СтрокаПротокола Из Протокол Цикл
        ФайлПротокола.ЗаписатьСтроку(СтрокаПротокола);
    КонецЦикла;
    ФайлПротокола.Закрыть();
КонецПроцедуры

Функция ПолучитьМолоко() Экспорт
    ПроверитьАдминистратора();
    Возврат Справочники.Номенклатура.НайтиПоНаименованию("Молоко 3,2%", Истина);
КонецФункции

Процедура СоздатьУчебныхПользователей() Экспорт
    ПроверитьАдминистратора();
    Для Каждого ИмяРоли Из СтрРазделить("ПолныеПрава;Покупка;Продажа", ";") Цикл
        ИмяПользователя = ?(ИмяРоли = "ПолныеПрава", "Администратор", ИмяРоли);
        Пользователь = ПользователиИнформационнойБазы.НайтиПоИмени(ИмяПользователя);
        Если Пользователь = Неопределено Тогда
            Пользователь = ПользователиИнформационнойБазы.СоздатьПользователя();
            Пользователь.Имя = ИмяПользователя;
            Пользователь.ПолноеИмя = ИмяПользователя;
            Пользователь.АутентификацияСтандартная = Истина;
            Пользователь.Роли.Добавить(Метаданные.Роли[ИмяРоли]);
            Пользователь.Записать();
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Функция ПроверитьРабочуюРоль() Экспорт
    Результат = Новый Массив;
    ЭтоПокупка = РольДоступна("Покупка");
    ЭтоПродажа = РольДоступна("Продажа");
    Утвердить(ЭтоПокупка <> ЭтоПродажа, "R01 Назначена одна рабочая роль", Результат);
    Утвердить(ПравоДоступа("Проведение", Метаданные.Документы.Приход) = ЭтоПокупка, "R02 Право проведения прихода", Результат);
    Утвердить(ПравоДоступа("Проведение", Метаданные.Документы.Расход) = ЭтоПродажа, "R03 Право проведения расхода", Результат);
    Утвердить(ПравоДоступа("Изменение", Метаданные.РегистрыСведений.Цены) = ЭтоПокупка, "R04 Изменение цен", Результат);
    Утвердить(Не ПравоДоступа("Администрирование", Метаданные), "R05 Нет административных прав", Результат);
    Утвердить(ПравоДоступа("Проведение", Метаданные.Документы.Бронирование) = ЭтоПродажа, "R08 Проведение брони по роли", Результат);
    Утвердить(ПравоДоступа("Чтение", Метаданные.РегистрыНакопления.РезервыПродукции), "R09 Чтение резервов доступно", Результат);
    Возврат СтрСоединить(Результат, Символы.ПС);
КонецФункции


Функция ПолучитьПустойСклад() Экспорт
    ПроверитьАдминистратора();
    НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
    Ссылка = СоздатьЭлемент(Справочники.Склады, "Тестовый пустой склад");
    ОтменитьТранзакцию();
    Возврат Ссылка;
КонецФункции

Функция ТестоваяБронь(Данные, Количество)
    Бронь = Документы.Бронирование.СоздатьДокумент();
    Бронь.Дата = ТекущаяДатаСеанса();
    Бронь.Организация = Данные.Организация;
    Бронь.Склад = Данные.Склад;
    Бронь.Покупатель = Данные.Покупатель;
    Товар = Бронь.Товары.Добавить();
    Товар.Номенклатура = Данные.Продукция[0];
    Товар.Количество = Количество;
    Товар.Цена = 90;
    Возврат Бронь;
КонецФункции

Функция ТестоваяПродажаБрони(Бронь)
    Продажа = Документы.Расход.СоздатьДокумент();
    Продажа.Дата = Бронь.Дата;
    Продажа.Организация = Бронь.Организация;
    Продажа.Склад = Бронь.Склад;
    Продажа.Покупатель = Бронь.Покупатель;
    Продажа.Бронирование = Бронь.Ссылка;
    Для Каждого СтрокаБрони Из Бронь.Товары Цикл
        Товар = Продажа.Товары.Добавить();
        ЗаполнитьЗначенияСвойств(Товар, СтрокаБрони);
    КонецЦикла;
    Возврат Продажа;
КонецФункции

Функция ТестовыйРезерв(Данные)
    Запрос = Новый Запрос("ВЫБРАТЬ ЕСТЬNULL(СУММА(КоличествоОстаток), 0) КАК Количество
    |ИЗ РегистрНакопления.РезервыПродукции.Остатки(, Организация = &Организация И Склад = &Склад)");
    Запрос.УстановитьПараметр("Организация", Данные.Организация);
    Запрос.УстановитьПараметр("Склад", Данные.Склад);
    Выборка = Запрос.Выполнить().Выбрать();
    Выборка.Следующий();
    Возврат Выборка.Количество;
КонецФункции

Процедура ПроверитьБронирование(КаталогПроекта) Экспорт
    ПроверитьАдминистратора();
    Протокол = Новый Массив;
    УдалитьДокументы = Новый Массив;
    Попытка
        Данные = ЗаполнитьПример(КаталогПроекта);
        Данные.Организация = СоздатьЭлемент(Справочники.Организации, "Испытания бронирования");
        Данные.Склад = СоздатьЭлемент(Справочники.Склады, "Склад испытаний бронирования");
        Приход = НовыйДокумент("Приход", Данные, 75, 1, 1);
        Пока Приход.Товары.Количество() > 1 Цикл
            Приход.Товары.Удалить(Приход.Товары[1]);
        КонецЦикла;
        Приход.Записать(РежимЗаписиДокумента.Проведение);
        УдалитьДокументы.Добавить(Приход.Ссылка);
        Бронь = ТестоваяБронь(Данные, 20);
        Бронь.Записать(РежимЗаписиДокумента.Проведение);
        УдалитьДокументы.Добавить(Бронь.Ссылка);
        Утвердить(Остаток(Данные, 0) = 75 И ТестовыйРезерв(Данные) = 20, "B01 Бронь 20: склад 75, резерв 20, свободно 55", Протокол);
        Бронь.Записать(РежимЗаписиДокумента.Проведение);
        Утвердить(ТестовыйРезерв(Данные) = 20, "B02 Перепроведение брони без дублей", Протокол);
        Продажа = ТестоваяПродажаБрони(Бронь);
        Продажа.Бронирование = Документы.Бронирование.ПустаяСсылка();
        Продажа.Товары[0].Количество = 56;
        ОжидаетсяОтказ(Продажа, "B03 Обычная продажа 56 при свободных 55 отклонена", Протокол);
        Утвердить(Остаток(Данные, 0) = 75 И ТестовыйРезерв(Данные) = 20, "B04 Неуспешная продажа не меняет остатки", Протокол);
        ОжидаетсяОтказ(ТестоваяБронь(Данные, 56), "B05 Вторая бронь сверх свободного остатка отклонена", Протокол);
        ОшибкаБрони = ТестоваяБронь(Данные, 11);
        Товар = ОшибкаБрони.Товары.Добавить();
        ЗаполнитьЗначенияСвойств(Товар, ОшибкаБрони.Товары[0]);
        Товар.Количество = 45;
        ОжидаетсяОтказ(ОшибкаБрони, "B06 Повторяющиеся строки брони проверены суммарно", Протокол);
        Продажа.Товары[0].Количество = 55;
        Продажа.Записать(РежимЗаписиДокумента.Проведение);
        УдалитьДокументы.Добавить(Продажа.Ссылка);
        Утвердить(Остаток(Данные, 0) = 20 И ТестовыйРезерв(Данные) = 20, "B07 Продажа ровно свободного остатка разрешена", Протокол);
        Продажа.Записать(РежимЗаписиДокумента.ОтменаПроведения);
        Утвердить(Остаток(Данные, 0) = 75 И ТестовыйРезерв(Данные) = 20, "B08 Отмена обычной продажи сохраняет бронь", Протокол);
        ОжидаетсяОтказ(Приход, "B09 Отмена прихода под действующей бронью запрещена", Протокол, РежимЗаписиДокумента.ОтменаПроведения);
        ОшибкаПродажи = ТестоваяПродажаБрони(Бронь);
        ОшибкаПродажи.Товары[0].Количество = 19;
        ОжидаетсяОтказ(ОшибкаПродажи, "B10 Частичная продажа брони отклонена", Протокол);
        ОшибкаПродажи = ТестоваяПродажаБрони(Бронь);
        ОшибкаПродажи.Покупатель = СоздатьЭлемент(Справочники.Покупатели, "Другой покупатель испытаний");
        ОжидаетсяОтказ(ОшибкаПродажи, "B11 Другой покупатель по брони отклонен", Протокол);
        ОшибкаПродажи = ТестоваяПродажаБрони(Бронь);
        ОшибкаПродажи.Склад = Справочники.Склады.НайтиПоНаименованию("Холодильный склад", Истина);
        ОжидаетсяОтказ(ОшибкаПродажи, "B12 Другой склад по брони отклонен", Протокол);
        ОшибкаПродажи = ТестоваяПродажаБрони(Бронь);
        ОшибкаПродажи.Дата = Бронь.Дата - 1;
        ОжидаетсяОтказ(ОшибкаПродажи, "B13 Продажа раньше брони отклонена", Протокол);
        Бронь.Записать(РежимЗаписиДокумента.ОтменаПроведения);
        Утвердить(Остаток(Данные, 0) = 75 И ТестовыйРезерв(Данные) = 0, "B14 Отмена брони: свободно снова 75", Протокол);
        ОжидаетсяОтказ(ТестоваяПродажаБрони(Бронь), "B15 Продажа по отмененной брони отклонена", Протокол);
        Бронь.Записать(РежимЗаписиДокумента.ОтменаПроведения);
        Утвердить(ТестовыйРезерв(Данные) = 0, "B16 Повторная отмена не удваивает возврат", Протокол);
        Бронь.Записать(РежимЗаписиДокумента.Проведение);
        ПродажаБрони = ТестоваяПродажаБрони(Бронь);
        ПродажаБрони.Записать(РежимЗаписиДокумента.Проведение);
        УдалитьДокументы.Добавить(ПродажаБрони.Ссылка);
        Утвердить(Остаток(Данные, 0) = 55 И ТестовыйРезерв(Данные) = 0, "B17 Продажа брони: склад 55, резерв 0, свободно 55", Протокол);
        Утвердить(УчетФермы.СостояниеБрони(Бронь.Ссылка) = "Продана", "B18 Состояние брони Продана", Протокол);
        ПродажаБрони.Записать(РежимЗаписиДокумента.Проведение);
        Утвердить(Остаток(Данные, 0) = 55 И ТестовыйРезерв(Данные) = 0, "B19 Перепроведение продажи без повторного списания", Протокол);
        ОжидаетсяОтказ(ТестоваяПродажаБрони(Бронь), "B20 Повторная продажа одной брони отклонена", Протокол);
        ОжидаетсяОтказ(Бронь, "B21 Отмена проданной брони запрещена", Протокол, РежимЗаписиДокумента.ОтменаПроведения);
        Бронь.Товары[0].Количество = 21;
        ОжидаетсяОтказ(Бронь, "B22 Изменение проданной брони запрещено", Протокол);
        Бронь = Бронь.Ссылка.ПолучитьОбъект();
        ПродажаБрони.Записать(РежимЗаписиДокумента.ОтменаПроведения);
        Утвердить(Остаток(Данные, 0) = 75 И ТестовыйРезерв(Данные) = 20, "B23 Отмена продажи возвращает товар в резерв", Протокол);
        Бронь.Записать(РежимЗаписиДокумента.ОтменаПроведения);
        Утвердить(Остаток(Данные, 0) = 75 И ТестовыйРезерв(Данные) = 0, "B24 Последующая отмена брони освобождает товар", Протокол);
        ОжидаетсяОтказ(ТестоваяБронь(Данные, 0), "B25 Бронь с нулевым количеством отклонена", Протокол);
        ОжидаетсяОтказ(ТестоваяБронь(Данные, -1), "B26 Бронь с отрицательным количеством отклонена", Протокол);
        Бронь = ТестоваяБронь(Данные, 75);
        Бронь.Записать(РежимЗаписиДокумента.Проведение);
        УдалитьДокументы.Добавить(Бронь.Ссылка);
        Утвердить(ТестовыйРезерв(Данные) = 75, "B27 Весь остаток может быть забронирован", Протокол);
        ОжидаетсяОтказ(ТестоваяБронь(Данные, 1), "B28 Бронь при нулевом свободном остатке отклонена", Протокол);
        Бронь.Записать(РежимЗаписиДокумента.ОтменаПроведения);
        Протокол.Добавить("COMPLETE");
    Исключение
        Если ТранзакцияАктивна() Тогда ОтменитьТранзакцию(); КонецЕсли;
        Протокол.Добавить("ERROR | " + ОписаниеОшибки());
    КонецПопытки;
    // Удаляем только документы, созданные этой процедурой, в обратном порядке.
    Индекс = УдалитьДокументы.Количество() - 1;
    Пока Индекс >= 0 Цикл
        Попытка
            Документ = УдалитьДокументы[Индекс].ПолучитьОбъект();
            Если Документ.Проведен Тогда Документ.Записать(РежимЗаписиДокумента.ОтменаПроведения); КонецЕсли;
            Документ.Удалить();
        Исключение
            Протокол.Добавить("ERROR | Очистка: " + ОписаниеОшибки());
        КонецПопытки;
        Индекс = Индекс - 1;
    КонецЦикла;
    ФайлПротокола = Новый ЗаписьТекста(КаталогПроекта + "/.build/reservation-tests.txt", КодировкаТекста.UTF8);
    Для Каждого СтрокаПротокола Из Протокол Цикл ФайлПротокола.ЗаписатьСтроку(СтрокаПротокола); КонецЦикла;
    ФайлПротокола.Закрыть();
КонецПроцедуры

Функция ПодготовитьПроверкуФормыБрони(КаталогПроекта) Экспорт
    ПроверитьАдминистратора();
    Данные = ЗаполнитьПример(КаталогПроекта);
    Бронь = ТестоваяБронь(Данные, 5);
    Бронь.Записать(РежимЗаписиДокумента.Проведение);
    Возврат Бронь.Ссылка;
КонецФункции

Функция СостояниеБрониДляТеста(Бронь) Экспорт
    ПроверитьАдминистратора();
    Возврат УчетФермы.СостояниеБрони(Бронь);
КонецФункции

Процедура ОтменитьПродажуТестаБрони(Бронь, Удалять = Ложь) Экспорт
    ПроверитьАдминистратора();
    Запрос = Новый Запрос("ВЫБРАТЬ Ссылка ИЗ Документ.Расход ГДЕ Бронирование = &Бронь");
    Запрос.УстановитьПараметр("Бронь", Бронь);
    Выборка = Запрос.Выполнить().Выбрать();
    Пока Выборка.Следующий() Цикл
        Продажа = Выборка.Ссылка.ПолучитьОбъект();
        Если Продажа.Проведен Тогда Продажа.Записать(РежимЗаписиДокумента.ОтменаПроведения); КонецЕсли;
        Если Удалять Тогда Продажа.Удалить(); КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Процедура ЗавершитьПроверкуФормыБрони(Бронь) Экспорт
    ПроверитьАдминистратора();
    ОтменитьПродажуТестаБрони(Бронь, Истина);
    Документ = Бронь.ПолучитьОбъект();
    Если Документ.Проведен Тогда Документ.Записать(РежимЗаписиДокумента.ОтменаПроведения); КонецЕсли;
    Документ.Удалить();
КонецПроцедуры
