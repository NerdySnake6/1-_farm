&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    Заголовок = "Остатки продукции";
    АвтоЗаголовок = Ложь;
    ЦветФона = Новый Цвет(248, 246, 238);
    НачалоПериода = НачалоМесяца(ТекущаяДатаСеанса());
    КонецПериода = КонецДня(ТекущаяДатаСеанса());

    ДобавитьПоле("КонецПериода", "КонецПериода", "Остатки на дату");
    Элементы.КонецПериода.Формат = "ДФ=dd.MM.yyyy";
    ДобавитьПоле("ОтборОрганизация", "ОтборОрганизация", "Организация");
    ДобавитьПоле("ОтборСклад", "ОтборСклад", "Склад");
    ДобавитьКнопку("СформироватьОтчет", "Сформировать отчёт");
    ДобавитьКнопку("СброситьОтборы", "Все организации и склады");
    ДобавитьКнопку("ПечатьОтчета", "Печать отчёта");
    Поле = Элементы.Добавить("РезультатОтчета", Тип("ПолеФормы"));
    Поле.Вид = ВидПоляФормы.ПолеТабличногоДокумента;
    Поле.ПутьКДанным = "РезультатОтчета";
    Поле.Заголовок = "Данные отчёта";
    Поле.ТолькоПросмотр = Истина;
    СформироватьНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура СформироватьОтчет(Команда) Экспорт
    СформироватьНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура СброситьОтборы(Команда) Экспорт
    ОтборОрганизация = Неопределено;
    ОтборСклад = Неопределено;
    СформироватьНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ПечатьОтчета(Команда)
    РезультатОтчета.Напечатать();
КонецПроцедуры

&НаСервере
Процедура СформироватьНаСервере()
    Если Ложь И НачалоПериода > КонецПериода Тогда
        Сообщить("Начало периода должно быть не позже конца периода.");
        Возврат;
    КонецЕсли;
    Запрос = Новый Запрос;
    Запрос.Текст = "ВЫБРАТЬ Д.Организация, Д.Склад, Д.Номенклатура КАК Продукция,
    |Д.Номенклатура.ЕдиницаИзмерения КАК Единица,
    |СУММА(Д.НаСкладе) КАК НаСкладе, СУММА(Д.Резерв) КАК ВРезерве,
    |СУММА(Д.НаСкладе) - СУММА(Д.Резерв) КАК Свободно
    |ИЗ (ВЫБРАТЬ Организация, Склад, Номенклатура, КоличествоОстаток КАК НаСкладе, 0 КАК Резерв
    |ИЗ РегистрНакопления.ОстаткиПродукции.Остатки(&Конец)
    |ОБЪЕДИНИТЬ ВСЕ ВЫБРАТЬ Организация, Склад, Номенклатура, 0, КоличествоОстаток
    |ИЗ РегистрНакопления.РезервыПродукции.Остатки(&Конец)) КАК Д
    |ГДЕ (&ВсеОрганизации ИЛИ Д.Организация = &Организация)
    |И (&ВсеСклады ИЛИ Д.Склад = &Склад)
    |СГРУППИРОВАТЬ ПО Д.Организация, Д.Склад, Д.Номенклатура, Д.Номенклатура.ЕдиницаИзмерения
    |УПОРЯДОЧИТЬ ПО Организация, Склад, Продукция";
    Запрос.УстановитьПараметр("Начало", НачалоДня(НачалоПериода));
    Запрос.УстановитьПараметр("Конец", КонецДня(КонецПериода));
    Запрос.УстановитьПараметр("Организация", ОтборОрганизация);
    Запрос.УстановитьПараметр("Склад", ОтборСклад);
    Запрос.УстановитьПараметр("ВсеОрганизации", Не ЗначениеЗаполнено(ОтборОрганизация));
    Запрос.УстановитьПараметр("ВсеСклады", Не ЗначениеЗаполнено(ОтборСклад));
    Таблица = Запрос.Выполнить().Выгрузить();
    РезультатОтчета.Очистить();
    РезультатОтчета.АвтоМасштаб = Истина;
    РезультатОтчета.Область(1, 1).Текст = "Остатки продукции";
    РезультатОтчета.Область(1, 1).Шрифт = Новый Шрифт(, 14, Истина);
    РезультатОтчета.Область(2, 1).Текст = "Дата отчёта: " + Формат(КонецПериода, "ДФ=dd.MM.yyyy");
    Для Индекс = 0 По Таблица.Колонки.Количество() - 1 Цикл
        Ячейка = РезультатОтчета.Область(4, Индекс + 1);
        Ячейка.Текст = ?(Таблица.Колонки[Индекс].Имя = "Единица", "Ед. изм.", Таблица.Колонки[Индекс].Имя);
        Ячейка.ЦветФона = Новый Цвет(47, 107, 79);
        Ячейка.ЦветТекста = Новый Цвет(255, 255, 255);
        Ячейка.Шрифт = Новый Шрифт(, 10, Истина);
        РезультатОтчета.Область(, Индекс + 1, , Индекс + 1).ШиринаКолонки = 25;
    КонецЦикла;
    НомерСтроки = 5;
    Для Каждого СтрокаТаблицы Из Таблица Цикл
        Для Индекс = 0 По Таблица.Колонки.Количество() - 1 Цикл
            Ячейка = РезультатОтчета.Область(НомерСтроки, Индекс + 1);
            Если ТипЗнч(СтрокаТаблицы[Индекс]) = Тип("Число") Тогда
                Ячейка.СодержитЗначение = Истина;
                Ячейка.Значение = СтрокаТаблицы[Индекс];
            Иначе
                Ячейка.Текст = Строка(СтрокаТаблицы[Индекс]);
            КонецЕсли;
            Если НомерСтроки % 2 = 0 Тогда
                Ячейка.ЦветФона = Новый Цвет(237, 244, 237);
            КонецЕсли;
        КонецЦикла;
        НомерСтроки = НомерСтроки + 1;
    КонецЦикла;

    Если Таблица.Количество() = 0 Тогда
        РезультатОтчета.Область(5, 1).Текст = "По выбранным условиям данных нет";
    КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ДобавитьПоле(Имя, Путь, Заголовок, Родитель = Неопределено)
    Поле = Элементы.Добавить(Имя, Тип("ПолеФормы"), Родитель);
    Поле.Вид = ВидПоляФормы.ПолеВвода;
    Поле.ПутьКДанным = Путь;
    Поле.Заголовок = Заголовок;
КонецПроцедуры

&НаСервере
Процедура ДобавитьКнопку(Имя, Заголовок, Родитель = Неопределено)
    Команда = Команды.Добавить(Имя);
    Команда.Заголовок = Заголовок;
    Команда.Действие = Имя;
    Кнопка = Элементы.Добавить(Имя, Тип("КнопкаФормы"), Родитель);
    Кнопка.ИмяКоманды = Имя;
    Кнопка.ЦветФона = Новый Цвет(47, 107, 79);
    Кнопка.ЦветТекста = Новый Цвет(255, 255, 255);
    Если Имя = "УдалитьСтроку" Или Имя = "СброситьОтборы"
        Или Имя = "ОткрытьПриходы" Или Имя = "ОткрытьРасходы" Тогда
        Кнопка.ЦветФона = Новый Цвет(230, 239, 231);
        Кнопка.ЦветТекста = Новый Цвет(32, 56, 44);
    КонецЕсли;
КонецПроцедуры
