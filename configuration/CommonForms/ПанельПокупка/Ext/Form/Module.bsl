&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    Заголовок = "Покупка продукции";
    АвтоЗаголовок = Ложь;
    ЦветФона = Новый Цвет(248, 246, 238);
    Подпись = Элементы.Добавить("НазваниеФермы", Тип("ДекорацияФормы"));
    Подпись.Вид = ВидДекорацииФормы.Надпись;
    Подпись.Заголовок = "Молочная ферма Луговая";
    Подпись.Шрифт = Новый Шрифт(, 20, Истина);
    Подпись.ЦветТекста = Новый Цвет(47, 107, 79);
    Подпись = Элементы.Добавить("ОписаниеФермы", Тип("ДекорацияФормы"));
    Подпись.Вид = ВидДекорацииФормы.Надпись;
    Подпись.Заголовок = "Поступление и продажа молока, творога и сметаны";
    Разделы = Элементы.Добавить("РазделыРаботы", Тип("ГруппаФормы"));
    Разделы.Вид = ВидГруппыФормы.ОбычнаяГруппа;
    Разделы.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная;
    Разделы.ОтображатьЗаголовок = Ложь;
    Операции = Элементы.Добавить("Операции", Тип("ГруппаФормы"), Разделы);
    Операции.Вид = ВидГруппыФормы.ОбычнаяГруппа;
    Операции.Заголовок = "Документы";
    ГруппаСправочников = Элементы.Добавить("СправочныеДанные", Тип("ГруппаФормы"), Разделы);
    ГруппаСправочников.Вид = ВидГруппыФормы.ОбычнаяГруппа;
    ГруппаСправочников.Заголовок = "Продукция и цены";
    ГруппаОтчетов = Элементы.Добавить("ОтчетыФермы", Тип("ГруппаФормы"), Разделы);
    ГруппаОтчетов.Вид = ВидГруппыФормы.ОбычнаяГруппа;
    ГруппаОтчетов.Заголовок = "Проверка результатов";
    Если РольДоступна("Покупка") Или РольДоступна("ПолныеПрава") Тогда
        ДобавитьКнопку("СоздатьПриход", "Оформить приход продукции", Операции);
        ДобавитьКнопку("ОткрытьПриходы", "Журнал поступлений", Операции);
    КонецЕсли;
    ДобавитьКнопку("ОткрытьПродукцию", "Продукция и фотографии", ГруппаСправочников);
    ДобавитьКнопку("ОткрытьЦены", "Цены продукции", ГруппаСправочников);
    ДобавитьКнопку("ОткрытьПоставщиков", "Поставщики", ГруппаСправочников);
    ДобавитьКнопку("ОткрытьОрганизации", "Организации", ГруппаСправочников);
    ДобавитьКнопку("ОткрытьСклады", "Склады", ГруппаСправочников);
    ДобавитьКнопку("ОткрытьОстатки", "Остатки на складе", ГруппаОтчетов);
    Подпись = Элементы.Добавить("ПорядокРаботы", Тип("ДекорацияФормы"));
    Подпись.Вид = ВидДекорацииФормы.Надпись;
    Подпись.Заголовок = "Начните с карточек продукции и цен. Затем оформите приход, продажу и проверьте остатки.";
КонецПроцедуры

