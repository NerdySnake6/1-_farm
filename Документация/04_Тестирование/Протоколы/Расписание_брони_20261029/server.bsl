Процедура ПроверитьРасписаниеБрони(КаталогПрогона) Экспорт
    Протокол = Новый ЗаписьТекста(КаталогПрогона + "/schedule.txt", КодировкаТекста.UTF8);
    Попытка
        Задания = РегламентныеЗадания.ПолучитьРегламентныеЗадания();
        Протокол.ЗаписатьСтроку("Заданий: " + Строка(Задания.Количество()));
        Для Каждого Задание Из Задания Цикл
            Протокол.ЗаписатьСтроку("Наименование: " + Задание.Наименование);
            Протокол.ЗаписатьСтроку("Использование: " + Строка(Задание.Использование));
            Протокол.ЗаписатьСтроку("Расписание: " + Строка(Задание.Расписание));
            Протокол.ЗаписатьСтроку("Период дней: " + Строка(Задание.Расписание.ПериодПовтораДней));
            Протокол.ЗаписатьСтроку("Повтор в течение дня: " + Строка(Задание.Расписание.ПериодПовтораВТечениеДня));
        КонецЦикла;
        Протокол.ЗаписатьСтроку("COMPLETE");
    Исключение
        Протокол.ЗаписатьСтроку("ERROR | " + ОписаниеОшибки());
    КонецПопытки;
    Протокол.Закрыть();
КонецПроцедуры

Функция ПодготовитьБрониДляРасписания() Экспорт
    Данные = ЗаполнитьПример("");
    Просрочена = ТестоваяБронь(Данные, 5);
    Просрочена.СрокБрони = НачалоДня(ТекущаяДатаСеанса()) - 1;
    Просрочена.Записать(РежимЗаписиДокумента.Проведение);
    Будущая = ТестоваяБронь(Данные, 3);
    Будущая.СрокБрони = ТекущаяДатаСеанса() + 86400;
    Будущая.Записать(РежимЗаписиДокумента.Проведение);
    Возврат Новый Структура("Просрочена,Будущая,Данные", Просрочена.Ссылка, Будущая.Ссылка, Данные);
КонецФункции

Функция СостояниеПроверкиРасписания(Ссылки) Экспорт
    Возврат Новый Структура("ПросроченаПроведена,БудущаяПроведена,Склад,Резерв",
        Ссылки.Просрочена.Проведен, Ссылки.Будущая.Проведен,
        Остаток(Ссылки.Данные, 0), ТестовыйРезерв(Ссылки.Данные));
КонецФункции

Процедура ВключитьМинутноеРасписаниеПроверки() Экспорт
    ПроверитьАдминистратора();
    Задания = РегламентныеЗадания.ПолучитьРегламентныеЗадания();
    Для Каждого Задание Из Задания Цикл
        Расписание = Новый РасписаниеРегламентногоЗадания;
        Расписание.ПериодПовтораДней = 1;
        Расписание.ПериодПовтораВТечениеДня = 60;
        Задание.Расписание = Расписание;
        Задание.Использование = Истина;
        Задание.ИмяПользователя = "Администратор";
        Задание.Записать();
    КонецЦикла;
КонецПроцедуры
