
Процедура НаблюдатьРасписаниеБрони() Экспорт
    Попытка
        Состояние = СервисФермы.СостояниеПроверкиРасписания(ПроверкаРасписанияСсылки);
        Прошло = ТекущаяДата() - ПроверкаРасписанияНачало;
        ПроверкаРасписанияПротокол.ЗаписатьСтроку("Этап " + Строка(ПроверкаРасписанияЭтап)
            + "; прошло " + Строка(Прошло) + " с; просроченная проведена: " + Строка(Состояние.ПросроченаПроведена)
            + "; будущая проведена: " + Строка(Состояние.БудущаяПроведена)
            + "; склад " + Строка(Состояние.Склад) + "; резерв " + Строка(Состояние.Резерв));
        Если ПроверкаРасписанияЭтап = 1 И Прошло >= 70 Тогда
            Если Не Состояние.ПросроченаПроведена Тогда
                ВызватьИсключение "Бронь неожиданно снялась до настройки расписания";
            КонецЕсли;
            ПроверкаРасписанияПротокол.ЗаписатьСтроку("CONFIRMED | За 70 секунд исходное расписание не сняло просроченную бронь");
            СервисФермы.ВключитьМинутноеРасписаниеПроверки();
            ПроверкаРасписанияПротокол.ЗаписатьСтроку("CONFIGURED | Период дней 1, интервал 60 секунд, Администратор");
            ПроверкаРасписанияЭтап = 2;
            ПроверкаРасписанияНачало = ТекущаяДата();
        ИначеЕсли ПроверкаРасписанияЭтап = 2 Тогда
            Если Не Состояние.ПросроченаПроведена Тогда
                Если Не Состояние.БудущаяПроведена Или Состояние.Склад <> 75 Или Состояние.Резерв <> 3 Тогда
                    ВызватьИсключение "Неверное состояние после автоматического снятия";
                КонецЕсли;
                ПроверкаРасписанияПротокол.ЗаписатьСтроку("PASS | Планировщик снял просроченную бронь, будущая осталась, склад 75, резерв 3");
                ОтключитьОбработчикОжидания("НаблюдатьРасписаниеБрони");
                ПроверкаРасписанияПротокол.ЗаписатьСтроку("COMPLETE");
                ПроверкаРасписанияПротокол.Закрыть();
                ЗавершитьРаботуСистемы(Ложь);
            ИначеЕсли Прошло >= 130 Тогда
                ВызватьИсключение "Планировщик не снял бронь за 130 секунд после настройки";
            КонецЕсли;
        КонецЕсли;
    Исключение
        ПроверкаРасписанияПротокол.ЗаписатьСтроку("ERROR | " + ОписаниеОшибки());
        ОтключитьОбработчикОжидания("НаблюдатьРасписаниеБрони");
        ПроверкаРасписанияПротокол.Закрыть();
        ЗавершитьРаботуСистемы(Ложь);
    КонецПопытки;
КонецПроцедуры
