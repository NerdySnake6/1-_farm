Процедура ПроверитьИзмененияИванова(КаталогПроекта) Экспорт
    Протокол = Новый ЗаписьТекста(КаталогПроекта + "/.build/review-ivanov/new-features.txt", КодировкаТекста.UTF8);
    Попытка
        Данные = ЗаполнитьПример(КаталогПроекта);
        Данные.Организация = СоздатьЭлемент(Справочники.Организации, "Проверка срока брони");
        Данные.Склад = СоздатьЭлемент(Справочники.Склады, "Проверка срока брони");
        Приход = НовыйДокумент("Приход", Данные, 75, 1, 1);
        Приход.Записать(РежимЗаписиДокумента.Проведение);
        Просрочена = ТестоваяБронь(Данные, 5);
        Просрочена.СрокБрони = ТекущаяДатаСеанса() - 3600;
        Просрочена.Записать(РежимЗаписиДокумента.Проведение);
        Будущая = ТестоваяБронь(Данные, 5);
        Будущая.СрокБрони = ТекущаяДатаСеанса() + 86400;
        Будущая.Записать(РежимЗаписиДокумента.Проведение);
        БезСрока = ТестоваяБронь(Данные, 5);
        БезСрока.Записать(РежимЗаписиДокумента.Проведение);
        Продана = ТестоваяБронь(Данные, 5);
        Продана.СрокБрони = ТекущаяДатаСеанса() - 3600;
        Продана.Записать(РежимЗаписиДокумента.Проведение);
        Продажа = ТестоваяПродажаБрони(Продана);
        Продажа.Записать(РежимЗаписиДокумента.Проведение);
        УчетФермы.СнятьПросроченныеБрони();
        Если Просрочена.Ссылка.Проведен Тогда ВызватьИсключение "Просроченная бронь не снята"; КонецЕсли;
        Протокол.ЗаписатьСтроку("PASS | EX01 Просроченная бронь снята");
        Если Не Будущая.Ссылка.Проведен Тогда ВызватьИсключение "Снята будущая бронь"; КонецЕсли;
        Протокол.ЗаписатьСтроку("PASS | EX02 Будущая бронь сохранена");
        Если Не БезСрока.Ссылка.Проведен Тогда ВызватьИсключение "Снята бронь без срока"; КонецЕсли;
        Протокол.ЗаписатьСтроку("PASS | EX03 Бронь без срока сохранена");
        Если Не Продана.Ссылка.Проведен Тогда ВызватьИсключение "Снята проданная бронь"; КонецЕсли;
        Протокол.ЗаписатьСтроку("PASS | EX04 Проданная бронь сохранена");
        Если ТестовыйРезерв(Данные) <> 10 Тогда ВызватьИсключение "Неверный резерв после снятия"; КонецЕсли;
        Протокол.ЗаписатьСтроку("PASS | EX05 Резерв после снятия равен 10");
        УчетФермы.СнятьПросроченныеБрони();
        Если ТестовыйРезерв(Данные) <> 10 Тогда ВызватьИсключение "Повторное снятие изменило резерв"; КонецЕсли;
        Протокол.ЗаписатьСтроку("PASS | EX06 Повторный запуск не меняет резерв");
        Протокол.ЗаписатьСтроку("COMPLETE");
    Исключение
        Протокол.ЗаписатьСтроку("ERROR | " + ОписаниеОшибки());
    КонецПопытки;
    Протокол.Закрыть();
КонецПроцедуры
