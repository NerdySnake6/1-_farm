Функция ТестоваяБронь(Данные, Количество)
    Бронь = Документы.Бронирование.СоздатьДокумент();
    Бронь.Дата = ТекущаяДатаСеанса();
    Бронь.Организация = Данные.Организация;
    Бронь.Склад = Данные.Склад;
    Бронь.Покупатель = Данные.Покупатель;
    Товар = Бронь.Товары.Добавить();
    Товар.Номенклатура = Данные.Продукция[0];
    Товар.Количество = Количество;
    Товар.Цена = 90;
    Возврат Бронь;
КонецФункции

Функция ТестоваяПродажаБрони(Бронь)
    Продажа = Документы.Расход.СоздатьДокумент();
    Продажа.Дата = Бронь.Дата;
    Продажа.Организация = Бронь.Организация;
    Продажа.Склад = Бронь.Склад;
    Продажа.Покупатель = Бронь.Покупатель;
    Продажа.Бронирование = Бронь.Ссылка;
    Для Каждого СтрокаБрони Из Бронь.Товары Цикл
        Товар = Продажа.Товары.Добавить();
        ЗаполнитьЗначенияСвойств(Товар, СтрокаБрони);
    КонецЦикла;
    Возврат Продажа;
КонецФункции

Функция ТестовыйРезерв(Данные)
    Запрос = Новый Запрос("ВЫБРАТЬ ЕСТЬNULL(СУММА(КоличествоОстаток), 0) КАК Количество
    |ИЗ РегистрНакопления.РезервыПродукции.Остатки(, Организация = &Организация И Склад = &Склад)");
    Запрос.УстановитьПараметр("Организация", Данные.Организация);
    Запрос.УстановитьПараметр("Склад", Данные.Склад);
    Выборка = Запрос.Выполнить().Выбрать();
    Выборка.Следующий();
    Возврат Выборка.Количество;
КонецФункции

Процедура ПроверитьБронирование(КаталогПроекта) Экспорт
    ПроверитьАдминистратора();
    Протокол = Новый Массив;
    УдалитьДокументы = Новый Массив;
    Попытка
        Данные = ЗаполнитьПример(КаталогПроекта);
        Данные.Организация = СоздатьЭлемент(Справочники.Организации, "Испытания бронирования");
        Данные.Склад = СоздатьЭлемент(Справочники.Склады, "Склад испытаний бронирования");
        Приход = НовыйДокумент("Приход", Данные, 75, 1, 1);
        Пока Приход.Товары.Количество() > 1 Цикл
            Приход.Товары.Удалить(Приход.Товары[1]);
        КонецЦикла;
        Приход.Записать(РежимЗаписиДокумента.Проведение);
        УдалитьДокументы.Добавить(Приход.Ссылка);
        Бронь = ТестоваяБронь(Данные, 20);
        Бронь.Записать(РежимЗаписиДокумента.Проведение);
        УдалитьДокументы.Добавить(Бронь.Ссылка);
        Утвердить(Остаток(Данные, 0) = 75 И ТестовыйРезерв(Данные) = 20, "B01 Бронь 20: склад 75, резерв 20, свободно 55", Протокол);
        Бронь.Записать(РежимЗаписиДокумента.Проведение);
        Утвердить(ТестовыйРезерв(Данные) = 20, "B02 Перепроведение брони без дублей", Протокол);
        Продажа = ТестоваяПродажаБрони(Бронь);
        Продажа.Бронирование = Документы.Бронирование.ПустаяСсылка();
        Продажа.Товары[0].Количество = 56;
        ОжидаетсяОтказ(Продажа, "B03 Обычная продажа 56 при свободных 55 отклонена", Протокол);
        Утвердить(Остаток(Данные, 0) = 75 И ТестовыйРезерв(Данные) = 20, "B04 Неуспешная продажа не меняет остатки", Протокол);
        ОжидаетсяОтказ(ТестоваяБронь(Данные, 56), "B05 Вторая бронь сверх свободного остатка отклонена", Протокол);
        ОшибкаБрони = ТестоваяБронь(Данные, 11);
        Товар = ОшибкаБрони.Товары.Добавить();
        ЗаполнитьЗначенияСвойств(Товар, ОшибкаБрони.Товары[0]);
        Товар.Количество = 45;
        ОжидаетсяОтказ(ОшибкаБрони, "B06 Повторяющиеся строки брони проверены суммарно", Протокол);
        Продажа.Товары[0].Количество = 55;
        Продажа.Записать(РежимЗаписиДокумента.Проведение);
        УдалитьДокументы.Добавить(Продажа.Ссылка);
        Утвердить(Остаток(Данные, 0) = 20 И ТестовыйРезерв(Данные) = 20, "B07 Продажа ровно свободного остатка разрешена", Протокол);
        Продажа.Записать(РежимЗаписиДокумента.ОтменаПроведения);
        Утвердить(Остаток(Данные, 0) = 75 И ТестовыйРезерв(Данные) = 20, "B08 Отмена обычной продажи сохраняет бронь", Протокол);
        ОжидаетсяОтказ(Приход, "B09 Отмена прихода под действующей бронью запрещена", Протокол, РежимЗаписиДокумента.ОтменаПроведения);
        ОшибкаПродажи = ТестоваяПродажаБрони(Бронь);
        ОшибкаПродажи.Товары[0].Количество = 19;
        ОжидаетсяОтказ(ОшибкаПродажи, "B10 Частичная продажа брони отклонена", Протокол);
        ОшибкаПродажи = ТестоваяПродажаБрони(Бронь);
        ОшибкаПродажи.Покупатель = СоздатьЭлемент(Справочники.Покупатели, "Другой покупатель испытаний");
        ОжидаетсяОтказ(ОшибкаПродажи, "B11 Другой покупатель по брони отклонен", Протокол);
        ОшибкаПродажи = ТестоваяПродажаБрони(Бронь);
        ОшибкаПродажи.Склад = Справочники.Склады.НайтиПоНаименованию("Холодильный склад", Истина);
        ОжидаетсяОтказ(ОшибкаПродажи, "B12 Другой склад по брони отклонен", Протокол);
        ОшибкаПродажи = ТестоваяПродажаБрони(Бронь);
        ОшибкаПродажи.Дата = Бронь.Дата - 1;
        ОжидаетсяОтказ(ОшибкаПродажи, "B13 Продажа раньше брони отклонена", Протокол);
        Бронь.Записать(РежимЗаписиДокумента.ОтменаПроведения);
        Утвердить(Остаток(Данные, 0) = 75 И ТестовыйРезерв(Данные) = 0, "B14 Отмена брони: свободно снова 75", Протокол);
        ОжидаетсяОтказ(ТестоваяПродажаБрони(Бронь), "B15 Продажа по отмененной брони отклонена", Протокол);
        Бронь.Записать(РежимЗаписиДокумента.ОтменаПроведения);
        Утвердить(ТестовыйРезерв(Данные) = 0, "B16 Повторная отмена не удваивает возврат", Протокол);
        Бронь.Записать(РежимЗаписиДокумента.Проведение);
        ПродажаБрони = ТестоваяПродажаБрони(Бронь);
        ПродажаБрони.Записать(РежимЗаписиДокумента.Проведение);
        УдалитьДокументы.Добавить(ПродажаБрони.Ссылка);
        Утвердить(Остаток(Данные, 0) = 55 И ТестовыйРезерв(Данные) = 0, "B17 Продажа брони: склад 55, резерв 0, свободно 55", Протокол);
        Утвердить(УчетФермы.СостояниеБрони(Бронь.Ссылка) = "Продана", "B18 Состояние брони Продана", Протокол);
        ПродажаБрони.Записать(РежимЗаписиДокумента.Проведение);
        Утвердить(Остаток(Данные, 0) = 55 И ТестовыйРезерв(Данные) = 0, "B19 Перепроведение продажи без повторного списания", Протокол);
        ОжидаетсяОтказ(ТестоваяПродажаБрони(Бронь), "B20 Повторная продажа одной брони отклонена", Протокол);
        ОжидаетсяОтказ(Бронь, "B21 Отмена проданной брони запрещена", Протокол, РежимЗаписиДокумента.ОтменаПроведения);
        Бронь.Товары[0].Количество = 21;
        ОжидаетсяОтказ(Бронь, "B22 Изменение проданной брони запрещено", Протокол);
        Бронь = Бронь.Ссылка.ПолучитьОбъект();
        ПродажаБрони.Записать(РежимЗаписиДокумента.ОтменаПроведения);
        Утвердить(Остаток(Данные, 0) = 75 И ТестовыйРезерв(Данные) = 20, "B23 Отмена продажи возвращает товар в резерв", Протокол);
        Бронь.Записать(РежимЗаписиДокумента.ОтменаПроведения);
        Утвердить(Остаток(Данные, 0) = 75 И ТестовыйРезерв(Данные) = 0, "B24 Последующая отмена брони освобождает товар", Протокол);
        ОжидаетсяОтказ(ТестоваяБронь(Данные, 0), "B25 Бронь с нулевым количеством отклонена", Протокол);
        ОжидаетсяОтказ(ТестоваяБронь(Данные, -1), "B26 Бронь с отрицательным количеством отклонена", Протокол);
        Бронь = ТестоваяБронь(Данные, 75);
        Бронь.Записать(РежимЗаписиДокумента.Проведение);
        УдалитьДокументы.Добавить(Бронь.Ссылка);
        Утвердить(ТестовыйРезерв(Данные) = 75, "B27 Весь остаток может быть забронирован", Протокол);
        ОжидаетсяОтказ(ТестоваяБронь(Данные, 1), "B28 Бронь при нулевом свободном остатке отклонена", Протокол);
        Бронь.Записать(РежимЗаписиДокумента.ОтменаПроведения);
        Протокол.Добавить("COMPLETE");
    Исключение
        Если ТранзакцияАктивна() Тогда ОтменитьТранзакцию(); КонецЕсли;
        Протокол.Добавить("ERROR | " + ОписаниеОшибки());
    КонецПопытки;
    // Удаляем только документы, созданные этой процедурой, в обратном порядке.
    Индекс = УдалитьДокументы.Количество() - 1;
    Пока Индекс >= 0 Цикл
        Попытка
            Документ = УдалитьДокументы[Индекс].ПолучитьОбъект();
            Если Документ.Проведен Тогда Документ.Записать(РежимЗаписиДокумента.ОтменаПроведения); КонецЕсли;
            Документ.Удалить();
        Исключение
            Протокол.Добавить("ERROR | Очистка: " + ОписаниеОшибки());
        КонецПопытки;
        Индекс = Индекс - 1;
    КонецЦикла;
    ФайлПротокола = Новый ЗаписьТекста(КаталогПроекта + "/.build/reservation-tests.txt", КодировкаТекста.UTF8);
    Для Каждого СтрокаПротокола Из Протокол Цикл ФайлПротокола.ЗаписатьСтроку(СтрокаПротокола); КонецЦикла;
    ФайлПротокола.Закрыть();
КонецПроцедуры

Функция ПодготовитьПроверкуФормыБрони(КаталогПроекта) Экспорт
    ПроверитьАдминистратора();
    Данные = ЗаполнитьПример(КаталогПроекта);
    Бронь = ТестоваяБронь(Данные, 5);
    Бронь.Записать(РежимЗаписиДокумента.Проведение);
    Возврат Бронь.Ссылка;
КонецФункции

Функция СостояниеБрониДляТеста(Бронь) Экспорт
    ПроверитьАдминистратора();
    Возврат УчетФермы.СостояниеБрони(Бронь);
КонецФункции

Процедура ОтменитьПродажуТестаБрони(Бронь, Удалять = Ложь) Экспорт
    ПроверитьАдминистратора();
    Запрос = Новый Запрос("ВЫБРАТЬ Ссылка ИЗ Документ.Расход ГДЕ Бронирование = &Бронь");
    Запрос.УстановитьПараметр("Бронь", Бронь);
    Выборка = Запрос.Выполнить().Выбрать();
    Пока Выборка.Следующий() Цикл
        Продажа = Выборка.Ссылка.ПолучитьОбъект();
        Если Продажа.Проведен Тогда Продажа.Записать(РежимЗаписиДокумента.ОтменаПроведения); КонецЕсли;
        Если Удалять Тогда Продажа.Удалить(); КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Процедура ЗавершитьПроверкуФормыБрони(Бронь) Экспорт
    ПроверитьАдминистратора();
    ОтменитьПродажуТестаБрони(Бронь, Истина);
    Документ = Бронь.ПолучитьОбъект();
    Если Документ.Проведен Тогда Документ.Записать(РежимЗаписиДокумента.ОтменаПроведения); КонецЕсли;
    Документ.Удалить();
КонецПроцедуры
