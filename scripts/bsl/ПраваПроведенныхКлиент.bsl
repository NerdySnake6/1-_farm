    Если Лев(ПараметрЗапуска, 16) = "FarmPostedTests=" Тогда
        КаталогПрогона = Сред(ПараметрЗапуска, 17);
        ПротоколПрав = Новый ЗаписьТекста(КаталогПрогона + "/posted-" + ИмяПользователя() + ".txt", КодировкаТекста.UTF8);
        Для Каждого ИмяДокумента Из СтрРазделить("Приход;Расход;Бронирование", ";") Цикл
            Разрешен = ИмяПользователя() = "Администратор" Или (ИмяПользователя() = "Покупка" И ИмяДокумента = "Приход")
                Или (ИмяПользователя() = "Продажа" И ИмяДокумента <> "Приход");
            Попытка
                Если СервисФермы.ПравоИзмененияПроведенных(ИмяДокумента) <> Разрешен Тогда
                    ПротоколПрав.ЗаписатьСтроку("ERROR | Нет права интерактивного изменения: " + ИмяДокумента);
                Иначе
                    ПротоколПрав.ЗаписатьСтроку("PASS | Право по роли: " + ИмяДокумента);
                КонецЕсли;
                Если Не Разрешен Тогда Продолжить; КонецЕсли;
                ДанныеПрав = СервисФермы.ДанныеПроверкиПроведенных();
                Исходные = СервисФермы.КоличестваПроверкиПроведенных(ДанныеПрав);
                ФормаПрав = ПолучитьФорму("Документ." + ИмяДокумента + ".Форма.Форма");
                ФормаПрав.Объект.Дата = ТекущаяДата();
                ФормаПрав.Объект.Организация = ДанныеПрав.Организация;
                ФормаПрав.Объект.Склад = ДанныеПрав.Склад;
                Если ИмяДокумента = "Приход" Тогда
                    ФормаПрав.Объект.Поставщик = ДанныеПрав.Поставщик;
                Иначе
                    ФормаПрав.Объект.Покупатель = ДанныеПрав.Покупатель;
                КонецЕсли;
                ТоварПрав = ФормаПрав.Объект.Товары.Добавить();
                ТоварПрав.Номенклатура = ДанныеПрав.Продукция;
                ТоварПрав.Количество = 2;
                ТоварПрав.Цена = 90;
                Направление = ?(ИмяДокумента = "Приход", 1, ?(ИмяДокумента = "Расход", -1, 0));
                Для ШагПрав = 1 По 6 Цикл
                    Если ШагПрав = 2 Тогда
                        ФормаПрав = ПолучитьФорму("Документ." + ИмяДокумента + ".Форма.Форма",
                            Новый Структура("Ключ", ФормаПрав.Объект.Ссылка));
                    КонецЕсли;
                    Если ШагПрав = 3 Тогда ФормаПрав.Объект.Товары[0].Количество = 3; КонецЕсли;
                    ОтменаПрав = ШагПрав = 4 Или ШагПрав = 6;
                    ФормаПрав.Модифицированность = Истина;
                    УспехЗаписи = ФормаПрав.Записать(Новый Структура("РежимЗаписи,РежимПроведения",
                        ?(ОтменаПрав, РежимЗаписиДокумента.ОтменаПроведения, РежимЗаписиДокумента.Проведение),
                        РежимПроведенияДокумента.Неоперативный));
                    Если Не УспехЗаписи Тогда ВызватьИсключение "Форма отказала в записи"; КонецЕсли;
                    КоличествоПрав = ?(ОтменаПрав, 0, ?(ШагПрав < 3, 2, 3));
                    Текущие = СервисФермы.КоличестваПроверкиПроведенных(ДанныеПрав);
                    Если Текущие.Склад <> Исходные.Склад + Направление * КоличествоПрав
                        Или Текущие.Резерв <> Исходные.Резерв + ?(ИмяДокумента = "Бронирование", КоличествоПрав, 0) Тогда
                        ВызватьИсключение "Неверные остатки после шага " + Строка(ШагПрав);
                    КонецЕсли;
                    ПротоколПрав.ЗаписатьСтроку("PASS | " + ИмяДокумента + " шаг " + Строка(ШагПрав)
                        + ": склад " + Строка(Текущие.Склад) + ", резерв " + Строка(Текущие.Резерв));
                КонецЦикла;
            Исключение
                ПротоколПрав.ЗаписатьСтроку("ERROR | " + ИмяДокумента + ": " + ОписаниеОшибки());
            КонецПопытки;
        КонецЦикла;
        Если ИмяПользователя() <> "Покупка" Тогда
            Попытка
                ДанныеПрав = СервисФермы.ДанныеПроверкиПроведенных();
                Исходные = СервисФермы.КоличестваПроверкиПроведенных(ДанныеПрав);
                СсылкаСвязи = Неопределено;
                Для ШагСвязи = 1 По 5 Цикл
                    Если ШагСвязи < 3 Тогда
                        ИмяСвязи = ?(ШагСвязи = 1, "Бронирование", "Расход");
                        ФормаСвязи = ПолучитьФорму("Документ." + ИмяСвязи + ".Форма.Форма");
                        ФормаСвязи.Объект.Дата = ТекущаяДата();
                        ФормаСвязи.Объект.Организация = ДанныеПрав.Организация;
                        ФормаСвязи.Объект.Склад = ДанныеПрав.Склад;
                        ФормаСвязи.Объект.Покупатель = ДанныеПрав.Покупатель;
                        Если ШагСвязи = 2 Тогда ФормаСвязи.Объект.Бронирование = СсылкаСвязи; КонецЕсли;
                        СтрокаСвязи = ФормаСвязи.Объект.Товары.Добавить();
                        СтрокаСвязи.Номенклатура = ДанныеПрав.Продукция;
                        СтрокаСвязи.Количество = 20;
                        СтрокаСвязи.Цена = 90;
                    ИначеЕсли ШагСвязи = 3 Тогда
                        ФормаСвязи = ПолучитьФорму("Документ.Расход.Форма.Форма", Новый Структура("Ключ", ФормаСвязи.Объект.Ссылка));
                    ИначеЕсли ШагСвязи = 5 Тогда
                        ФормаСвязи = ПолучитьФорму("Документ.Бронирование.Форма.Форма", Новый Структура("Ключ", СсылкаСвязи));
                    КонецЕсли;
                    ФормаСвязи.Модифицированность = Истина;
                    Если Не ФормаСвязи.Записать(Новый Структура("РежимЗаписи,РежимПроведения",
                        ?(ШагСвязи >= 4, РежимЗаписиДокумента.ОтменаПроведения, РежимЗаписиДокумента.Проведение),
                        РежимПроведенияДокумента.Неоперативный)) Тогда
                        ВызватьИсключение "Отказ записи связанного документа";
                    КонецЕсли;
                    Если ШагСвязи = 1 Тогда СсылкаСвязи = ФормаСвязи.Объект.Ссылка; КонецЕсли;
                    Текущие = СервисФермы.КоличестваПроверкиПроведенных(ДанныеПрав);
                    Если Текущие.Склад <> Исходные.Склад - ?(ШагСвязи = 2 Или ШагСвязи = 3, 20, 0)
                        Или Текущие.Резерв <> Исходные.Резерв + ?(ШагСвязи = 1 Или ШагСвязи = 4, 20, 0) Тогда
                        ВызватьИсключение "Неверные остатки связанной продажи";
                    КонецЕсли;
                    ПротоколПрав.ЗаписатьСтроку("PASS | Связанная продажа шаг " + Строка(ШагСвязи)
                        + ": склад " + Строка(Текущие.Склад) + ", резерв " + Строка(Текущие.Резерв));
                КонецЦикла;
            Исключение
                ПротоколПрав.ЗаписатьСтроку("ERROR | Связанная продажа: " + ОписаниеОшибки());
            КонецПопытки;
        КонецЕсли;
        ПротоколПрав.ЗаписатьСтроку("COMPLETE");
        ПротоколПрав.Закрыть();
        ЗавершитьРаботуСистемы(Ложь);
        Возврат;
    КонецЕсли;
