Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
    УчетФермы.ЗаблокироватьУчет();
    Если УчетФермы.ЕстьПродажаПоБрони(Ссылка) Тогда
        ВызватьИсключение "Бронь продана. Сначала отмените проведение связанной продажи.";
    КонецЕсли;
    Если РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения Тогда
        Возврат;
    КонецЕсли;
    Если Не ЗначениеЗаполнено(Организация) Или Не ЗначениеЗаполнено(Склад)
        Или Не ЗначениеЗаполнено(Покупатель) Или Товары.Количество() = 0 Тогда
        ВызватьИсключение "Заполните организацию, склад, покупателя и продукцию.";
    КонецЕсли;
    Для Каждого Товар Из Товары Цикл
        Если Не ЗначениеЗаполнено(Товар.Номенклатура) Или Товар.Количество <= 0 Или Товар.Цена <= 0 Тогда
            ВызватьИсключение "Укажите продукцию, положительное количество и цену.";
        КонецЕсли;
        Товар.Сумма = Окр(Товар.Количество * Товар.Цена, 2);
    КонецЦикла;
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
    Движения.РезервыПродукции.Записывать = Истина;
    Движения.РезервыПродукции.Очистить();
    Для Каждого Товар Из Товары Цикл
        Движение = Движения.РезервыПродукции.Добавить();
        Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
        Движение.Период = Дата;
        Движение.Организация = Организация;
        Движение.Склад = Склад;
        Движение.Номенклатура = Товар.Номенклатура;
        Движение.Бронирование = Ссылка;
        Движение.Количество = Товар.Количество;
    КонецЦикла;
    Движения.РезервыПродукции.Записать();
    УчетФермы.ПроверитьОстатки(Организация, Склад, Отказ);
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
    УчетФермы.ЗаблокироватьУчет();
    Если УчетФермы.ЕстьПродажаПоБрони(Ссылка) Тогда
        ВызватьИсключение "Нельзя отменить проданную бронь. Сначала отмените проведение продажи.";
    КонецЕсли;
    Движения.РезервыПродукции.Записывать = Истина;
    Движения.РезервыПродукции.Очистить();
    Движения.РезервыПродукции.Записать();
    УчетФермы.ПроверитьОстатки(Организация, Склад, Отказ);
КонецПроцедуры
