Функция ДанныеПроверкиПроведенных() Экспорт
    Возврат Новый Структура("Организация,Склад,Поставщик,Покупатель,Продукция",
        Справочники.Организации.НайтиПоНаименованию("Молочная ферма Луговая"),
        Справочники.Склады.НайтиПоНаименованию("Холодильный склад"),
        Справочники.Поставщики.НайтиПоНаименованию("Кооператив Молочный край"),
        Справочники.Покупатели.НайтиПоНаименованию("Магазин Свежие продукты"),
        Справочники.Номенклатура.НайтиПоНаименованию("Молоко 3,2%"));
КонецФункции

Функция КоличестваПроверкиПроведенных(Данные) Экспорт
    Результат = Новый Структура("Склад,Резерв", 0, 0);
    Для Каждого Вид Из СтрРазделить("ОстаткиПродукции;РезервыПродукции", ";") Цикл
        Запрос = Новый Запрос("ВЫБРАТЬ СУММА(КоличествоОстаток) КАК Количество ИЗ РегистрНакопления."
            + Вид + ".Остатки(, Организация = &Организация И Склад = &Склад И Номенклатура = &Продукция)");
        Запрос.УстановитьПараметр("Организация", Данные.Организация);
        Запрос.УстановитьПараметр("Склад", Данные.Склад);
        Запрос.УстановитьПараметр("Продукция", Данные.Продукция);
        Выборка = Запрос.Выполнить().Выбрать();
        Если Выборка.Следующий() И ЗначениеЗаполнено(Выборка.Количество) Тогда
            Результат[?(Вид = "ОстаткиПродукции", "Склад", "Резерв")] = Выборка.Количество;
        КонецЕсли;
    КонецЦикла;
    Возврат Результат;
КонецФункции

Функция ПравоИзмененияПроведенных(ИмяДокумента) Экспорт
    Возврат ПравоДоступа("ИнтерактивноеИзменениеПроведенных", Метаданные.Документы[ИмяДокумента]);
КонецФункции
